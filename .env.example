# Copier ce fichier en ".env" puis adapter. Toute variable absente prend sa valeur par défaut.

# Réseau
PORT=3000
HOST=0.0.0.0

# Dossier des données (base + fichiers + sauvegardes). Idéalement un disque dédié, ex. D:\ISR_DATA ou /srv/isr-data
# ISR_DATA_DIR=/srv/isr-data

# Taille maximale d'un fichier déposé, en Go (défaut 20) et espace disque à toujours garder libre, en Go (défaut 2)
ISR_MAX_FILE_GB=20
ISR_MIN_FREE_GB=2

# Durée d'une session sans activité, en heures (défaut 12)
ISR_SESSION_HOURS=12

# HTTPS natif : chemins du certificat et de la clé (PEM). Voir docs/EXPLOITATION.md
# ISR_TLS_CERT=/srv/isr-data/tls/isr.crt
# ISR_TLS_KEY=/srv/isr-data/tls/isr.key

# Derrière un proxy inverse (nginx, Caddy...) : 1 pour lire la vraie IP des clients, et ISR_HTTPS=1 si le proxy fait le HTTPS
# ISR_TRUST_PROXY=1
# ISR_HTTPS=1

# Mot de passe initial du compte « admin » (sinon généré et affiché UNE fois au premier démarrage)
# ISR_ADMIN_PASSWORD=
